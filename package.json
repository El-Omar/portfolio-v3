{
  "name": "portfolio-v3",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:El-Omar/portfolio-v3.git",
  "author": "El-Omar <elomar.sami@gmail.com>",
  "license": "MIT",
  "scripts": {
    "docker:up": "docker-compose -f infrastructure/docker/development/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/development/docker-compose.yml down",
    "docker:logs": "docker-compose -f infrastructure/docker/development/docker-compose.yml logs -f",
    "docker:rebuild": "docker-compose -f infrastructure/docker/development/docker-compose.yml up -d --build",

    "build:shared": "yarn workspace @portfolio-v3/shared build",
    "dev:shared": "yarn workspace @portfolio-v3/shared watch",
    "dev:frontend": "yarn workspace frontend dev",
    "dev:backend": "yarn workspace backend dev"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ]
}
